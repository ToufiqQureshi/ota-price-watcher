# Server
PORT=3000

# SQLite (swap for Postgres later the same way OpenWA does — via config, not code)
DATABASE_PATH=./data/gommt-price-watcher.sqlite

# AES-256-GCM key used to encrypt stored GoMMT credentials + browser session state at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# How often (ms) each active hotel session is polled for price/inventory changes.
# Keep this sane — this hits a real hotelier login session, not a public API.
POLL_INTERVAL_MS=60000

# Playwright
PLAYWRIGHT_HEADLESS=true

# Outbound webhook signing (HMAC-SHA256, same scheme as OpenWA's webhook module)
WEBHOOK_SIGNING_HEADER=X-Signature
